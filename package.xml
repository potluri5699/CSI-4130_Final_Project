<?xml version="1.0"?>
<package format="3">
  <name>osm_robot_navigation</name>
  <version>1.0.0</version>
  <description>OSM/OSMnx A* global route planner with a PyQt GUI and RViz2 visualization.</description>
  <maintainer email="potluri@oakland.edu">Student</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
