Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Road network1
        - /Planned path1
        - /Route markers1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 20
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /road_network
      Name: Road network
      Namespaces:
        osm_roads: true
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Head Diameter: 0.5
      Head Length: 0.5
      Length: 0
      Line Style: Billboards
      Line Width: 1.5
      Name: Planned path
      Color: 255; 140; 0
      Alpha: 1
      Shaft Diameter: 0.35
      Shaft Length: 0.5
      Topic:
        Value: /planned_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /route_markers
      Name: Route markers
      Namespaces:
        route_goal: true
        route_start: true
        route_waypoints: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18000
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: 0.7
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
